<section class="contact-section">
  <div class="page-width">
    <div class="contact-container">
      <!-- Contact Information -->
      <div class="contact-info">
        <div class="contact-info__content">
          <h1 class="contact-title">Get in Touch</h1>

          <div class="contact-description">
            <p>We'd love to hear from you! Whether you have questions about our products, want to share your experience, or are interested in wholesale opportunities, our team is here to help.</p>
          </div>

          <div class="contact-details">
            <div class="contact-details__item">
              <div class="contact-details__icon">
                {% render 'icon-map' %}
              </div>
              <div class="contact-details__content">
                <h3 class="contact-details__title">Our Location</h3>
                <address class="contact-details__text">
                  Prestige West Woods, Magadi Road, Gopalpura, Bengaluru, Karnataka 560023
                </address>
                <a href="https://www.google.com/maps/place/PRESTIGE+WEST+WOODS,+Gopalapura,+Binnipete,+Bengaluru,+Karnataka+560023,+India/@12.9776301,77.5630992,18z/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-details__link">
                  Get Directions
                </a>
              </div>
            </div>

            <div class="contact-details__item">
              <div class="contact-details__icon">
                {% render 'icon-phone' %}
              </div>
              <div class="contact-details__content">
                <h3 class="contact-details__title">Phone</h3>
                <a href="tel:+919098404225" class="contact-details__text">
                  +91 90984 04225
                </a>
              </div>
            </div>

            <div class="contact-details__item">
              <div class="contact-details__icon">
                {% render 'icon-email' %}
              </div>
              <div class="contact-details__content">
                <h3 class="contact-details__title">Email</h3>
                <a href="mailto:natureburst.shop@gmail.com" class="contact-details__text">
                  natureburst.shop@gmail.com
                </a>
              </div>
            </div>

            <div class="contact-details__item">
              <div class="contact-details__icon">
                {% render 'icon-instagram' %}
              </div>
              <div class="contact-details__content">
                <h3 class="contact-details__title">Follow Us</h3>
                <a href="https://instagram.com/tropitreats.shop"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-details__text">
                  @tropitreats.shop
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-container">
        <div class="contact-form-wrapper">
          <h1 class="contact-form__title">Contact Us</h1>

          {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
                <p class="form-status__message" role="status">
                  Thanks for contacting us! We'll get back to you as soon as possible.
                </p>
              </div>
            {%- endif -%}

            {%- if form.errors -%}
              <div class="contact-form__message contact-form__message--error">
                <h3>Error</h3>
                <ul>
                  {%- for field in form.errors -%}
                    <li>{{ form.errors.messages[field] }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <div class="contact__fields">
              <div class="field">
                <input
                  class="field__input"
                  type="text"
                  id="ContactForm-name"
                  name="contact[name]"
                  value="{% if form.name %}{{ form.name }}{% endif %}"
                  placeholder="Name"
                >
                <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
              </div>

              <div class="field field--required">
                <input
                  class="field__input"
                  type="email"
                  id="ContactForm-email"
                  name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% endif %}"
                  placeholder="Email"
                  required
                  autocorrect="off"
                  autocapitalize="off"
                >
                <label class="field__label" for="ContactForm-email">
                  Email <span aria-hidden="true">*</span>
                </label>
              </div>
            </div>

            <div class="field">
              <textarea
                rows="10"
                id="ContactForm-body"
                class="text-area field__input"
                name="contact[body]"
                placeholder="Comment"
              >{% if form.body %}{{ form.body }}{% endif %}</textarea>
              <label class="form__label field__label" for="ContactForm-body">
                Comment
              </label>
            </div>

            <div class="contact__button">
              <button type="submit" class="button button--primary">
                Send
              </button>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* Base section styling */
.contact-section {
  padding: 4rem 0;
  background-color: #f7f7f7;
  font-family: 'Montserrat', sans-serif;
}

.page-width {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

.contact-container {
  display: grid;
  gap: 3rem;
}

/* Contact Information */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.contact-title {
  font-size: 2.5rem;
  margin-bottom: 1.5rem;
  color: var(--color-headings, #1a2e37);
  position: relative;
}

.contact-title:after {
  content: '';
  position: absolute;
  bottom: -15px;
  left: 0;
  width: 60px;
  height: 3px;
  background-color: #2A5E41;
  border-radius: 2px;
}

.contact-description {
  margin-bottom: 2rem;
  color: var(--color-text, #333333);
  line-height: 1.7;
}

.contact-details {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.contact-details__item {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
}

.contact-details__icon {
  background: rgba(42, 94, 65, 0.1);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2A5E41;
  flex-shrink: 0;
}

.contact-details__content {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.contact-details__title {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0;
  color: var(--color-headings, #1a2e37);
}

.contact-details__text {
  color: var(--color-text, #333333);
  text-decoration: none;
  transition: color 0.3s ease;
  font-style: normal;
  line-height: 1.6;
}

.contact-details__text:hover,
.contact-details__link:hover {
  color: #2A5E41;
}

.contact-details__link {
  color: #2A5E41;
  text-decoration: none;
  font-weight: 600;
  margin-top: 0.5rem;
  display: inline-block;
  transition: color 0.3s ease;
}

/* Contact Form - Updated Styles */
.contact-form-container {
  background: white;
  border-radius: 12px;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
  overflow: hidden;
  height: 100%;
}

.contact-form-wrapper {
  padding: 2.5rem;
}

.contact-form__title {
  font-size: 2rem;
  margin-bottom: 2rem;
  color: var(--color-headings, #1a2e37);
  position: relative;
}

.contact-form__title:after {
  content: '';
  position: absolute;
  bottom: -15px;
  left: 0;
  width: 60px;
  height: 3px;
  background-color: #2A5E41;
  border-radius: 2px;
}

/* Status messages */
.form-status {
  padding: 1.25rem;
  border-radius: 8px;
  margin-bottom: 1.5rem;
  background-color: #EDF7ED;
}

.form-status__message {
  color: #1B5E20;
  margin: 0;
}

.contact-form__message--error {
  background-color: #FEF2F2;
  color: #B91C1C;
  padding: 1.25rem;
  border-radius: 8px;
  margin-bottom: 1.5rem;
}

.contact-form__message h3 {
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

/* Field styling */
.contact__fields {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: repeat(2, 1fr);
  margin-bottom: 1.5rem;
}

.field {
  position: relative;
  margin-bottom: 1.5rem;
}

.field__input,
.text-area {
  width: 100%;
  padding: 1rem 1.2rem;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background-color: #f8f9fa;
  font-family: 'Montserrat', sans-serif;
  font-size: 1rem;
  transition: all 0.3s ease;
}

.field__input:focus,
.text-area:focus {
  border-color: #2A5E41;
  box-shadow: 0 0 0 2px rgba(42, 94, 65, 0.1);
  outline: none;
  background-color: white;
}

.field__label {
  position: absolute;
  top: 0;
  left: 1rem;
  transform: translateY(-50%);
  background: white;
  padding: 0 0.5rem;
  font-size: 0.85rem;
  color: #64748b;
  pointer-events: none;
  transition: all 0.3s ease;
}

.field__input:focus + .field__label,
.field__input:not(:placeholder-shown) + .field__label,
.text-area:focus + .field__label,
.text-area:not(:placeholder-shown) + .field__label {
  color: #2A5E41;
  font-weight: 600;
  transform: translateY(-50%) scale(1.05);
}

.text-area {
  resize: vertical;
  min-height: 180px;
}

.contact__button {
  text-align: right;
}

.button--primary {
  background-color: #2A5E41;
  color: white;
  padding: 0.9rem 2rem;
  border: none;
  border-radius: 30px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.button--primary:hover {
  background-color: #234c36;
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(42, 94, 65, 0.3);
}

/* Responsive styles */
@media screen and (min-width: 1024px) {
  .contact-container {
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .contact-form-container {
    height: auto;
  }
}

@media screen and (min-width: 768px) and (max-width: 1023px) {
  .contact-container {
    grid-template-columns: 1fr;
    max-width: 700px;
    margin: 0 auto;
  }

  .contact-title,
  .contact-form__title {
    font-size: 2.2rem;
  }
}

@media screen and (max-width: 767px) {
  .contact-section {
    padding: 3rem 0;
  }

  .contact-container {
    grid-template-columns: 1fr;
  }

  .contact-title,
  .contact-form__title {
    font-size: 1.8rem;
    text-align: center;
  }

  .contact-title:after,
  .contact-form__title:after {
    left: 50%;
    transform: translateX(-50%);
  }

  .contact-description {
    text-align: center;
  }

  .contact-details__item {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .contact-details__content {
    align-items: center;
  }

  .contact__fields {
    grid-template-columns: 1fr;
  }

  .contact__button {
    text-align: center;
  }

  .button--primary {
    width: 100%;
  }

  .contact-form-wrapper {
    padding: 2rem 1.5rem;
  }
}

@media screen and (max-width: 480px) {
  .contact-section {
    padding: 2.5rem 0;
  }

  .contact-title,
  .contact-form__title {
    font-size: 1.6rem;
  }

  .contact-form-wrapper {
    padding: 1.75rem 1.25rem;
  }
}
</style>