{% comment %}
  Enhanced Footer Component
  - Improved visual design and structure
  - Better responsive behavior
  - Consistent font styling
{% endcomment %}

<footer class="site-footer" role="contentinfo">
  <div class="wave-divider">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 100">
      <path
        fill="#FFF"
        fill-opacity="1"
        d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,0L1360,0C1280,0,1120,0,960,0C800,0,640,0,480,0C320,0,160,0,80,0L0,0Z"
      ></path>
    </svg>
  </div>

  <div class="page-width">
    <div class="footer-content">
      <div class="logo-section">
        <h3>Nature<span>Burst</span></h3>
        <p>Premium freeze-dried fruits with all the natural goodness. No additives, no preservatives - just pure fruit bliss that keeps all the nutrition intact.</p>

        <div class="contact-info">
          <div class="contact-item">
            {% render 'icon-email' %}
            <span>natureburst.shop@gmail.com</span>
          </div>
          <div class="contact-item">
            {% render 'icon-phone-alt' %}
            <span>+91 90984 04225</span>
          </div>
        </div>

        <div class="social-icons">
          <a href="https://www.instagram.com/natureburst.shop" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            {% render 'icon-instagram' %}
          </a>
          <a href="https://www.facebook.com/profile.php?id=61574435489769" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            {% render 'icon-facebook' %}
          </a>
        </div>
      </div>

      <div class="links-section">
        <div class="link-group">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/collections/all">Shop</a></li>
            <li><a href="/pages/how-to-use">How to Use</a></li>
            <li><a href="/pages/contact">Contact</a></li>
            <li><a href="/policies/refund-policy">Refund Policy</a></li>
            <li><a href="/policies/terms-of-service">Terms of Service</a></li>
          </ul>
        </div>

        <div class="link-group location-group">
          <h4>Visit Us</h4>
          <address class="footer-address">
            Prestige West Woods, <br>
            Magadi Road, Gopalpura, <br>
            Bengaluru, Karnataka 560023
          </address>

          <a href="https://www.google.com/maps/place/PRESTIGE+WEST+WOODS,+Gopalapura,+Binnipete,+Bengaluru,+Karnataka+560023,+India/@12.9776301,77.5630992,18z/"
            target="_blank"
            rel="noopener noreferrer"
            class="directions-btn">
            <div class="map-indicator">
              {% render 'icon-map' %} Get Directions
            </div>
          </a>
        </div>
      </div>
    </div>

    <div class="bottom-section">
      <div class="payment-methods">
        <img src="{{ 'payment-methods.png' | asset_url }}" alt="Payment methods" width="300" height="30" loading="lazy">
      </div>

      <div class="footer__copyright">
        <small class="copyright__content">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</small>
      </div>
    </div>
  </div>
</footer>

<style>
/* Main footer container */
.site-footer {
  position: relative;
  background: #2A5E41;
  color: var(--color-white, #ffffff);
  padding: 5rem 0 2rem 0;
  font-family: 'Montserrat', sans-serif;
}

/* Wave divider effect at the top */
.wave-divider {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  line-height: 0;
}

.wave-divider svg {
  width: 100%;
  height: 60px;
}

/* Main content area */
.footer-content {
  display: grid;
  gap: 3rem;
  margin-bottom: 3rem;
}

/* Logo and branding section */
.logo-section h3 {
  font-size: 2.5rem;
  margin-bottom: 1.5rem;
  font-weight: 800;
  font-family: 'Montserrat', sans-serif;
}

.logo-section h3 span {
  color: #FFD166;
}

.logo-section p {
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 2rem;
  max-width: 500px;
  font-size: 1.1rem;
  line-height: 1.7;
  font-family: 'Montserrat', sans-serif;
}

/* Contact information styling */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 2rem;
}

.contact-item {
  display: flex;
  align-items: center;
}

.contact-item svg {
  margin-right: 1rem;
  color: #FFD166;
  flex-shrink: 0;
}

.contact-item span {
  color: rgba(255, 255, 255, 0.9);
  font-family: 'Montserrat', sans-serif;
}

/* Social media icons */
.social-icons {
  display: flex;
  gap: 1rem;
}

.social-icons a {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  color: var(--color-white, #ffffff);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.social-icons a:hover {
  background: #FFD166;
  color: #2A5E41;
  transform: translateY(-3px);
}

/* Footer links sections */
.links-section {
  display: grid;
  gap: 2.5rem;
}

.link-group h4 {
  margin-bottom: 1.5rem;
  font-size: 1.3rem;
  font-weight: 700;
  color: #FFD166;
  font-family: 'Montserrat', sans-serif;
}

.link-group ul {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.link-group a {
  color: rgba(255, 255, 255, 0.85);
  transition: all 0.3s ease;
  font-size: 1.05rem;
  font-family: 'Montserrat', sans-serif;
  text-decoration: none;
}

.link-group a:hover {
  color: #FFD166;
  padding-left: 0.5rem;
}

/* Address styling */
.footer-address {
  color: rgba(255, 255, 255, 0.85);
  font-style: normal;
  line-height: 1.8;
  margin-bottom: 1.25rem;
  font-size: 1.05rem;
  font-family: 'Montserrat', sans-serif;
}

/* Get directions button */
.directions-btn {
  text-decoration: none;
  display: inline-block;
}

.map-indicator {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  padding: 0.6rem 1.2rem;
  border-radius: 30px;
  color: white;
  font-weight: 500;
  transition: all 0.3s ease;
  font-family: 'Montserrat', sans-serif;
}

.map-indicator:hover {
  background: #FFD166;
  color: #2A5E41;
  transform: translateY(-2px);
}

.map-indicator svg {
  margin-right: 0.5rem;
}

/* Bottom section with payment methods and copyright */
.bottom-section {
  padding-top: 2rem;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.payment-methods img {
  max-width: 300px;
  height: auto;
}

.footer__copyright {
  text-align: center;
}

.copyright__content {
  color: rgba(255, 255, 255, 0.7);
  font-size: 0.95rem;
  font-family: 'Montserrat', sans-serif;
}

/* Responsive layout for desktop */
@media (min-width: 768px) {
  .footer-content {
    grid-template-columns: 1fr 1fr;
    align-items: start;
  }

  .links-section {
    grid-template-columns: 1fr 1fr;
  }

  .bottom-section {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 2.5rem;
  }
}

@media (min-width: 992px) {
  .footer-content {
    grid-template-columns: 1.1fr 0.9fr;
  }

  .links-section {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile responsiveness */
@media (max-width: 767px) {
  .site-footer {
    padding: 4rem 0 2rem;
    text-align: center;
  }

  .footer-content {
    grid-template-columns: 1fr;
  }

  .logo-section {
    margin-bottom: 1rem;
  }

  .logo-section h3 {
    font-size: 2rem;
  }

  .logo-section p {
    margin-left: auto;
    margin-right: auto;
  }

  .contact-info {
    align-items: center;
  }

  .contact-item {
    justify-content: center;
  }

  .social-icons {
    justify-content: center;
  }

  .links-section {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .link-group ul {
    align-items: center;
  }

  .link-group a {
    padding: 0.25rem 0;
  }

  .footer-address {
    max-width: 280px;
    margin-left: auto;
    margin-right: auto;
  }

  .directions-btn {
    display: table;
    margin: 0 auto;
  }

  .bottom-section {
    text-align: center;
  }

  .payment-methods {
    margin-bottom: 1rem;
  }
}

/* Extra small devices optimization */
@media (max-width: 480px) {
  .site-footer {
    padding: 3.5rem 0 1.5rem;
  }

  .logo-section h3 {
    font-size: 1.8rem;
  }

  .logo-section p {
    font-size: 1rem;
  }

  .contact-item svg {
    margin-right: 0.75rem;
  }

  .contact-item span {
    font-size: 0.95rem;
  }

  .payment-methods img {
    max-width: 250px;
  }
}
</style>