<!-- Updated product-benefits.liquid code -->
<div class="product-benefits section">
  <div class="page-width">
    <div class="header-container">
      <h2>{{ section.settings.title | escape }}</h2>
      <p>{{ section.settings.description }}</p>
    </div>

    <!-- New quadrant layout for product benefits -->
    <div class="benefits-quadrant">
      <div class="benefit-quadrant natural">
        <div class="quadrant-content">
          <div class="quadrant-icon">
            <img src="{{ 'icon-natural.png' | asset_url }}" alt="100% Natural" 
                 onerror="this.onerror=null; this.src='data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%2225%22%20fill%3D%22%23E8F5E9%22%20%2F%3E%3Cpath%20d%3D%22M30%2015C23%2020%2020%2032%2015%2042C28%2036%2040%2035%2045%2018C40%2022%2035%2022%2030%2015Z%22%20fill%3D%22%232A5E41%22%20%2F%3E%3C%2Fsvg%3E';">
          </div>
          <h3>100% Natural</h3>
        </div>
      </div>
      
      <div class="benefit-quadrant sugar-free">
        <div class="quadrant-content">
          <div class="quadrant-icon">
            <img src="{{ 'icon-sugar-free.png' | asset_url }}" alt="Zero Sugar" 
                 onerror="this.onerror=null; this.src='data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%2225%22%20fill%3D%22%23FFF8E1%22%20%2F%3E%3Cpath%20d%3D%22M24%2020L30%2015L36%2020L40%2026L36%2030L36%2040L24%2040L24%2030L20%2026L24%2020Z%22%20fill%3D%22%232A5E41%22%20%2F%3E%3Cline%20x1%3D%2215%22%20y1%3D%2215%22%20x2%3D%2245%22%20y2%3D%2245%22%20stroke%3D%22%232A5E41%22%20stroke-width%3D%224%22%20%2F%3E%3C%2Fsvg%3E';">
          </div>
          <h3>Zero Sugar</h3>
        </div>
      </div>
      
      <div class="benefit-quadrant preservatives">
        <div class="quadrant-content">
          <div class="quadrant-icon">
            <img src="{{ 'icon-preservatives.png' | asset_url }}" alt="Zero Preservatives" 
                 onerror="this.onerror=null; this.src='data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%2225%22%20fill%3D%22%23F3E5F5%22%20%2F%3E%3Cpath%20d%3D%22M25%2020H35V40H25V20Z%22%20fill%3D%22%232A5E41%22%20%2F%3E%3Cpath%20d%3D%22M27%2015L33%2015L33%2020H27V15Z%22%20fill%3D%22%232A5E41%22%20%2F%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%222%22%20fill%3D%22white%22%20%2F%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2235%22%20r%3D%222%22%20fill%3D%22white%22%20%2F%3E%3Cline%20x1%3D%2215%22%20y1%3D%2215%22%20x2%3D%2245%22%20y2%3D%2245%22%20stroke%3D%22%232A5E41%22%20stroke-width%3D%224%22%20%2F%3E%3C%2Fsvg%3E';">
          </div>
          <h3>Zero Preservatives</h3>
        </div>
      </div>
      
      <div class="benefit-quadrant nutrition">
        <div class="quadrant-content">
          <div class="quadrant-icon">
            <img src="{{ 'icon-nutrition.png' | asset_url }}" alt="Maximum Nutrition" 
                 onerror="this.onerror=null; this.src='data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%2225%22%20fill%3D%22%23E0F7FA%22%20%2F%3E%3Cpath%20d%3D%22M30%2015L45%2030L30%2045L15%2030L30%2015Z%22%20fill%3D%22%232A5E41%22%20%2F%3E%3Cpath%20d%3D%22M25%2025L35%2035%22%20stroke%3D%22white%22%20stroke-width%3D%223%22%20%2F%3E%3Cpath%20d%3D%22M35%2025L25%2035%22%20stroke%3D%22white%22%20stroke-width%3D%223%22%20%2F%3E%3C%2Fsvg%3E';">
          </div>
          <h3>Maximum Nutrition</h3>
        </div>
      </div>
    </div>

    <div class="key-benefits">
      {% for block in section.blocks %}
        {% if block.type == 'benefit_point' %}
          <div class="benefit">
            <span class="check-icon">{% render 'icon-check' %}</span>
            <span>{{ block.settings.text }}</span>
          </div>
        {% endif %}
      {% endfor %}

      <!-- Default benefits if no blocks are added -->
      {% if section.blocks.size == 0 %}
        <div class="benefit">
          <span class="check-icon">{% render 'icon-check' %}</span>
          <span>100% Natural Ingredients</span>
        </div>
        <div class="benefit">
          <span class="check-icon">{% render 'icon-check' %}</span>
          <span>No Added Sugar</span>
        </div>
        <div class="benefit">
          <span class="check-icon">{% render 'icon-check' %}</span>
          <span>Rich in Vitamins</span>
        </div>
        <div class="benefit">
          <span class="check-icon">{% render 'icon-check' %}</span>
          <span>Extended Shelf Life</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
.product-benefits {
  padding: 3rem 0;
  background: #f7f7f7;
}

.header-container {
  text-align: center;
  max-width: 800px;
  margin: 0 auto 2.5rem;
}

.header-container h2 {
  font-size: 2rem;
  font-weight: 700;
  color: #1a2e37;
  margin-bottom: 1rem;
}

.header-container h2 span {
  color: var(--color-primary);
}

.header-container p {
  line-height: 1.6;
  color: #666;
  margin-bottom: 1.5rem;
}

/* New quadrant layout */
.benefits-quadrant {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 1.5rem;
  max-width: 600px;
  aspect-ratio: 1/1; /* Creates a perfect square layout */
  margin: 0 auto 2.5rem;
}

.benefit-quadrant {
  border-radius: 12px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.benefit-quadrant:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
}

/* Quadrant content styling */
.quadrant-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  width: 100%;
}

.quadrant-icon {
  width: 80px;
  height: 80px;
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quadrant-icon img {
  width: 100%;
  height: auto;
  max-height: 80px;
  object-fit: contain;
}

.benefit-quadrant h3 {
  font-size: 1.2rem;
  font-weight: 700;
  margin: 0;
  color: #1a2e37;
}

/* Quadrant background colors */
.benefit-quadrant.natural {
  background-color: #E8F5E9; /* Light green */
}

.benefit-quadrant.sugar-free {
  background-color: #FFF8E1; /* Light yellow */
}

.benefit-quadrant.preservatives {
  background-color: #F3E5F5; /* Light purple */
}

.benefit-quadrant.nutrition {
  background-color: #E0F7FA; /* Light blue */
}

.key-benefits {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1rem;
  margin: 0 auto;
  max-width: 900px;
}

.benefit {
  display: flex;
  align-items: center;
  background: white;
  padding: 0.5rem 1rem;
  border-radius: 30px;
}

.check-icon {
  color: var(--color-primary);
  margin-right: 0.5rem;
}

.benefit span:not(.check-icon) {
  font-weight: 600;
  color: #1a2e37;
  font-size: 0.9rem;
}

/* Responsive adjustments */
@media (max-width: 767px) {
  .header-container h2 {
    font-size: 1.8rem;
  }
  
  /* Stack quadrants on mobile */
  .benefits-quadrant {
    grid-template-columns: 1fr;
    grid-template-rows: repeat(4, 1fr);
    aspect-ratio: auto;
    max-width: 100%;
  }
  
  .quadrant-icon {
    width: 60px;
    height: 60px;
  }
  
  .benefit-quadrant h3 {
    font-size: 1rem;
  }

  .key-benefits {
    flex-direction: column;
    align-items: center;
  }

  .benefit {
    width: 100%;
    max-width: 250px;
  }
}

/* For smaller mobile screens */
@media (max-width: 480px) {
  .benefits-quadrant {
    gap: 1rem;
  }
  
  .benefit-quadrant {
    padding: 1rem;
  }
}

/* For medium-sized screens/tablets */
@media (min-width: 768px) and (max-width: 991px) {
  .benefits-quadrant {
    max-width: 500px;
  }
}