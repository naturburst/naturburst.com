{% assign current_variant = product.selected_or_first_available_variant %}
{% assign featured_image = current_variant.featured_image | default: product.featured_image %}

<section class="product section">
  <div class="page-width">
    <div class="product__container">
      <!-- Left column: Product images and gallery -->
      <div class="product__media-wrapper">
        <div class="product-images-slider" data-product-images>
          <div class="product-featured-image-container">
            <img
              src="{{ featured_image | img_url: '1200x' }}"
              srcset="
                {{ featured_image | img_url: '400x' }} 400w,
                {{ featured_image | img_url: '800x' }} 800w,
                {{ featured_image | img_url: '1200x' }} 1200w,
                {{ featured_image | img_url: '1600x' }} 1600w
              "
              sizes="(min-width: 1100px) 550px, (min-width: 990px) 47.5vw, 90vw"
              alt="{{ featured_image.alt | escape }}"
              loading="eager"
              width="{{ featured_image.width }}"
              height="{{ featured_image.height }}"
              class="product-featured-image"
              id="ProductImage-{{ featured_image.id }}"
              data-media-id="{{ featured_image.id }}"
            >
          </div>

          {% if product.images.size > 1 %}
            <div class="product-gallery">
              {% for image in product.images %}
                <button
                  class="product-single__thumbnail{% if image.id == featured_image.id %} active{% endif %}"
                  data-src="{{ image | img_url: 'master' }}"
                  data-srcset="{{ image | img_url: width: 375 }} 375w, {{ image | img_url: width: 750 }} 750w, {{ image | img_url: width: 1100 }} 1100w, {{ image | img_url: width: 1500 }} 1500w, {{ image | img_url: 'master' }} {{ image.width }}w"
                  data-media-id="{{ image.id }}"
                >
                  <img
                    src="{{ image | img_url: '150x' }}"
                    alt="{{ image.alt | escape }}"
                    loading="lazy"
                    width="150"
                  >
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- Right column: Product information -->
      <div class="product__info-wrapper{% if section.settings.enable_sticky_info %} product__info-wrapper--sticky{% endif %}">
        <div class="product__info">
          {% if section.settings.show_vendor and product.vendor != blank %}
            <p class="product__vendor">{{ product.vendor }}</p>
          {% endif %}

          <h1 class="product__title">{{ product.title }}</h1>

          <div class="product__price-container">
            {%- liquid
              assign compare_at_price = current_variant.compare_at_price
              assign price = current_variant.price
              assign available = current_variant.available
            -%}

            {% if compare_at_price > price %}
              <div class="product__price product__price--sale">
                <span class="product__price-item product__price-item--sale">{{ price | money }}</span>
                <span class="product__price-item product__price-item--compare">{{ compare_at_price | money }}</span>
                <span class="product__price-item product__price-item--discount">
                  {% assign discount_percentage = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price %}
                  {{ discount_percentage }}% off
                </span>
              </div>
            {% else %}
              <div class="product__price">
                <span class="product__price-item">{{ price | money }}</span>
              </div>
            {% endif %}
          </div>

          {% if product.metafields.product.weight %}
            <div class="product__weight">
              <span>Weight:</span> {{ product.metafields.product.weight }}
            </div>
          {% endif %}

          <div class="product__description rte">
            {{ product.description }}
          </div>

          {% form 'product', product, id: 'ProductForm', class: 'product-form', data-product-form: '' %}
            <!-- Variant selector - handles options like size, color, etc. -->
            {%- unless product.has_only_default_variant -%}
              <div class="product__variants">
                {% for option in product.options_with_values %}
                  <div class="product__option">
                    <h3 class="product__option-label">{{ option.name }}:</h3>

                    <fieldset class="product__option-fieldset" name="{{ option.name | handleize }}">
                      <legend class="visually-hidden">{{ option.name }}</legend>

                      {%- for value in option.values -%}
                        {%- liquid
                          assign option_disabled = true
                          for variant in product.variants
                            if variant.available and variant.options contains value
                              assign option_disabled = false
                              break
                            endif
                          endfor
                        -%}

                        <input
                          type="radio"
                          id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          name="{{ option.name }}"
                          value="{{ value | escape }}"
                          {% if option.selected_value == value %}checked{% endif %}
                          {% if option_disabled %}disabled{% endif %}
                          class="visually-hidden"
                          data-option-position="{{ option.position }}"
                        >
                        <label
                          for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                          class="product__option-value{% if option.selected_value == value %} selected{% endif %}{% if option_disabled %} disabled{% endif %}"
                        >
                          {{ value | escape }}
                        </label>
                      {%- endfor -%}
                    </fieldset>
                  </div>
                {% endfor %}
              </div>
            {%- endunless -%}

            <!-- Current variant ID input -->
            <input type="hidden" name="id" value="{{ current_variant.id }}">

            <!-- Quantity selector -->
            {% if section.settings.show_quantity_selector %}
              <div class="product__quantity">
                <label for="Quantity" class="product__quantity-label">Quantity:</label>
                <div class="quantity-selector js-qty">
                  <button type="button" class="quantity-btn js-qty__dec" aria-label="Decrease quantity">
                    <span class="qty-text">−</span>
                  </button>
                  <input
                    type="number"
                    id="Quantity"
                    name="quantity"
                    class="quantity-input js-qty__input"
                    value="1"
                    min="1"
                    aria-label="Quantity"
                    data-quantity-input
                  >
                  <button type="button" class="quantity-btn js-qty__inc" aria-label="Increase quantity">
                    <span class="qty-text">+</span>
                  </button>
                </div>
              </div>
            {% endif %}

            <!-- Error message display area -->
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>

            <!-- Add to cart / Buy now buttons -->
            <div class="product-form__buttons">
              <button
                type="submit"
                name="add"
                class="product-form__submit btn btn--primary"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <span>
                  {%- if current_variant.available -%}
                    Add to cart
                  {%- else -%}
                    Sold out
                  {%- endif -%}
                </span>
                <div class="loading-overlay__spinner hidden">
                  <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                    <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                  </svg>
                </div>
              </button>

              {% if section.settings.enable_dynamic_checkout %}
                {{ form | payment_button }}
              {% endif %}
            </div>
          {% endform %}

          <!-- SKU and product details area -->
          <div class="product__details">
            {% if section.settings.show_sku and current_variant.sku != blank %}
              <div class="product__sku">
                <span>SKU:</span> {{ current_variant.sku }}
              </div>
            {% endif %}

            <!-- Blocks for additional product information -->
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'ingredients' %}
                  {% if product.metafields.product.ingredients %}
                    <details class="product__collapsible-section">
                      <summary class="product__collapsible-heading">
                        <span>{{ block.settings.title | default: 'Ingredients' }}</span>
                        <span class="icon-plus">{% render 'icon-plus' %}</span>
                        <span class="icon-minus">{% render 'icon-minus' %}</span>
                      </summary>
                      <div class="product__collapsible-content rte">
                        {{ product.metafields.product.ingredients }}
                      </div>
                    </details>
                  {% endif %}

                {% when 'nutritional_info' %}
                  {% if product.metafields.product.nutritional_info %}
                    <details class="product__collapsible-section">
                      <summary class="product__collapsible-heading">
                        <span>{{ block.settings.title | default: 'Nutritional Information' }}</span>
                        <span class="icon-plus">{% render 'icon-plus' %}</span>
                        <span class="icon-minus">{% render 'icon-minus' %}</span>
                      </summary>
                      <div class="product__collapsible-content rte">
                        {{ product.metafields.product.nutritional_info }}
                      </div>
                    </details>
                  {% endif %}

                {% when 'how_to_use' %}
                  {% if product.metafields.product.how_to_use %}
                    <details class="product__collapsible-section">
                      <summary class="product__collapsible-heading">
                        <span>{{ block.settings.title | default: 'How to Use' }}</span>
                        <span class="icon-plus">{% render 'icon-plus' %}</span>
                        <span class="icon-minus">{% render 'icon-minus' %}</span>
                      </summary>
                      <div class="product__collapsible-content rte">
                        {{ product.metafields.product.how_to_use }}
                      </div>
                    </details>
                  {% endif %}

                {% when 'custom' %}
                  {% if block.settings.content != blank %}
                    <details class="product__collapsible-section">
                      <summary class="product__collapsible-heading">
                        <span>{{ block.settings.title }}</span>
                        <span class="icon-plus">{% render 'icon-plus' %}</span>
                        <span class="icon-minus">{% render 'icon-minus' %}</span>
                      </summary>
                      <div class="product__collapsible-content rte">
                        {{ block.settings.content }}
                      </div>
                    </details>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>

          <!-- Free shipping, guarantee and delivery time info -->
          <div class="product__trust-badges">
            <div class="trust-badge">
              <span class="trust-badge__icon">{% render 'icon-truck' %}</span>
              <div class="trust-badge__text">
                <span class="trust-badge__title">Free Shipping</span>
                <span class="trust-badge__info">On orders over $50</span>
              </div>
            </div>
            <div class="trust-badge">
              <span class="trust-badge__icon">{% render 'icon-guarantee' %}</span>
              <div class="trust-badge__text">
                <span class="trust-badge__title">100% Satisfaction</span>
                <span class="trust-badge__info">30-day money back guarantee</span>
              </div>
            </div>
            <div class="trust-badge">
              <span class="trust-badge__icon">{% render 'icon-calendar' %}</span>
              <div class="trust-badge__text">
                <span class="trust-badge__title">Fast Delivery</span>
                <span class="trust-badge__info">2-5 business days</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<div id="ProductImageModal" class="image-modal" aria-hidden="true" role="dialog">
  <div class="image-modal__overlay" data-modal-close></div>
  <div class="image-modal__content">
    <button class="image-modal__close" aria-label="Close" data-modal-close>
      {% render 'icon-close' %}
    </button>

    <div class="image-modal__controls">
      <button class="image-modal__control image-modal__prev" aria-label="Previous image">
        {% render 'icon-chevron-left' %}
      </button>
      <button class="image-modal__control image-modal__next" aria-label="Next image">
        {% render 'icon-chevron-right' %}
      </button>
    </div>

    <div class="image-modal__image-container">
      <img
        src="{{ featured_image | img_url: 'master' }}"
        alt="{{ featured_image.alt | escape }}"
        class="image-modal__image"
      >
    </div>

    {% if product.images.size > 1 %}
      <div class="image-modal__thumbnails">
        {% for image in product.images %}
          <button
            class="image-modal__thumbnail{% if image.id == featured_image.id %} active{% endif %}"
            data-media-id="{{ image.id }}"
          >
            <img
              src="{{ image | img_url: '100x' }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="100"
            >
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_quantity_selector",
      "default": true,
      "label": "Show quantity selector"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "Enable sticky product information on desktop"
    },
    {
      "type": "checkbox",
      "id": "enable_dynamic_checkout",
      "default": true,
      "label": "Show dynamic checkout button",
      "info": "Lets customers check out directly using their preferred payment method. [Learn more](https://help.shopify.com/manual/using-themes/change-the-layout/dynamic-checkout)"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "default": true,
      "label": "Show SKU"
    }
  ],
  "blocks": [
    {
      "type": "ingredients",
      "name": "Ingredients",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Ingredients",
          "label": "Title"
        }
      ]
    },
    {
      "type": "nutritional_info",
      "name": "Nutritional Information",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Nutritional Information",
          "label": "Title"
        }
      ]
    },
    {
      "type": "how_to_use",
      "name": "How to Use",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "How to Use",
          "label": "Title"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.product {
  margin-bottom: 2rem;
}

.product__container {
  display: grid;
  gap: 3rem;
  grid-template-columns: 1fr;
}

.product-featured-image-container {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-base);
  box-shadow: var(--shadow-base);
  margin-bottom: 1.5rem;
  transition: var(--transition-base);
}

.product-featured-image-container:hover {
  box-shadow: var(--shadow-large);
}

.product-featured-image {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.75s cubic-bezier(0.19, 1, 0.22, 1);
}

.product-featured-image-container:hover .product-featured-image {
  transform: scale(1.03);
}

.product-gallery {
  display: flex;
  gap: 0.75rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: 0.5rem;
}

.product-gallery::-webkit-scrollbar {
  display: none;
}

.product-single__thumbnail {
  position: relative;
  min-width: 80px;
  height: 80px;
  border-radius: var(--radius-base);
  border: 2px solid var(--color-border);
  overflow: hidden;
  padding: 0;
  scroll-snap-align: start;
  transition: all 0.3s ease;
  opacity: 0.7;
  cursor: pointer;
}

.product-single__thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-single__thumbnail:hover {
  opacity: 0.9;
  border-color: var(--color-primary-lighter);
}

.product-single__thumbnail.active {
  opacity: 1;
  border-color: var(--color-primary);
}

/* Product info styles */
.product__info-wrapper {
  position: relative;
}

.product__info-wrapper--sticky {
  position: sticky;
  top: 100px;
}

.product__vendor {
  font-size: 0.9rem;
  color: var(--color-text-light);
  margin-bottom: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.product__title {
  margin-bottom: 1rem;
  font-size: 2.25rem;
  font-weight: 700;
  color: var(--color-headings);
  line-height: 1.2;
}

.product__price-container {
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
}

.product__price {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
}

.product__price-item {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-headings);
}

.product__price-item--sale {
  color: var(--color-primary);
}

.product__price-item--compare {
  font-size: 1.125rem;
  color: var(--color-text-light);
  text-decoration: line-through;
  font-weight: normal;
}

.product__price-item--discount {
  background-color: var(--color-primary);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-full);
  font-size: 0.875rem;
  font-weight: 600;
}

.product__weight {
  margin-bottom: 1.5rem;
  font-size: 0.95rem;
  color: var(--color-text);
}

.product__description {
  margin-bottom: 2rem;
  font-size: 1rem;
  line-height: 1.7;
  color: var(--color-text);
}

.product__description p {
  margin-bottom: 1.25rem;
}

/* Variants and options */
.product__variants {
  margin-bottom: 1.5rem;
}

.product__option {
  margin-bottom: 1.25rem;
}

.product__option-label {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--color-headings);
}

.product__option-fieldset {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  padding: 0;
  border: none;
}

.product__option-value {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  border-radius: var(--radius-full);
  border: 2px solid var(--color-border);
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-text);
  cursor: pointer;
  transition: all 0.3s ease;
}

.product__option-value:hover {
  border-color: var(--color-primary-lighter);
}

.product__option-value.selected {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: white;
}

.product__option-value.disabled {
  opacity: 0.4;
  cursor: not-allowed;
  text-decoration: line-through;
}

/* Quantity selector */
.product__quantity {
  margin-bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
}

.product__quantity-label {
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-headings);
}

.quantity-selector {
  display: inline-flex;
  align-items: center;
  border: 2px solid var(--color-border);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.quantity-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-background-light);
  border: none;
  cursor: pointer;
  font-size: 1.25rem;
  transition: all 0.2s ease;
  color: var(--color-primary);
  font-weight: 600;
}

.quantity-btn:hover {
  background: var(--color-background-accent);
  color: var(--color-primary-darker);
}

.quantity-btn:active {
  transform: scale(0.95);
}

.qty-text {
  font-size: 1.5rem;
  line-height: 1;
}

.quantity-input {
  width: 50px;
  height: 40px;
  border: none;
  text-align: center;
  font-size: 1rem;
  font-weight: 500;
  -moz-appearance: textfield;
}

.quantity-input::-webkit-outer-spin-button,
.quantity-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* Add to cart buttons */
.product-form__buttons {
  display: flex;
  gap: 1rem;
  margin-bottom: 2rem;
}

.product-form__submit {
  flex: 1;
  min-height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.shopify-payment-button {
  flex: 1;
}

.shopify-payment-button__button {
  min-height: 50px !important;
}

/* Product details accordion */
.product__details {
  border-top: 1px solid var(--color-border);
  padding-top: 2rem;
  margin-bottom: 2rem;
}

.product__sku {
  margin-bottom: 1rem;
  font-size: 0.9rem;
  color: var(--color-text-light);
}

.product__collapsible-section {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-base);
  margin-bottom: 1rem;
  overflow: hidden;
}

.product__collapsible-heading {
  padding: 1rem 1.25rem;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: var(--color-background-light);
  transition: all 0.3s ease;
}

.product__collapsible-heading:hover {
  background-color: var(--color-background-accent);
}

.product__collapsible-section[open] .product__collapsible-heading {
  border-bottom: 1px solid var(--color-border);
}

.icon-plus, .icon-minus {
  display: flex;
  transition: all 0.3s ease;
}

.product__collapsible-section[open] .icon-plus {
  display: none;
}

.product__collapsible-section:not([open]) .icon-minus {
  display: none;
}

.product__collapsible-content {
  padding: 1.25rem;
  font-size: 0.95rem;
  line-height: 1.7;
}

/* Trust badges */
.product__trust-badges {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}

.trust-badge {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.trust-badge__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--color-background-primary-light);
  color: var(--color-primary);
}

.trust-badge__text {
  display: flex;
  flex-direction: column;
}

.trust-badge__title {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-headings);
}

.trust-badge__info {
  font-size: 0.85rem;
  color: var(--color-text-light);
}

/* Responsive styles */
@media screen and (min-width: 768px) {
  .product__container {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .product-single__thumbnail {
    min-width: 100px;
    height: 100px;
  }
}

@media screen and (max-width: 767px) {
  .product__trust-badges {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  
  .product__title {
    font-size: 1.75rem;
  }
  
  .product-form__buttons {
    flex-direction: column;
  }
}

@media screen and (max-width: 480px) {
  .product__price {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
  
  .quantity-selector {
    width: 100%;
  }
  
  .quantity-input {
    flex: 1;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productForm = document.querySelector('form[data-product-form]');

  if (productForm) {
    productForm.addEventListener('submit', function(e) {
      e.preventDefault();

      const submitBtn = this.querySelector('.product-form__submit');

      // Show simple transition without spinner
      if (submitBtn) {
        submitBtn.classList.add('btn--loading');
        submitBtn.disabled = true;
      }

      // Submit the form via AJAX
      fetch('/cart/add.js', {
        method: 'POST',
        body: new FormData(this),
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => response.json())
      .then(data => {
        // Update cart count
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            const cartCountElements = document.querySelectorAll('[data-cart-count]');
            if (cartCountElements.length) {
              cartCountElements.forEach(el => {
                el.textContent = cart.item_count;
              });
            }
          });

        // Hide loading state and restore button after short delay
        setTimeout(() => {
          if (submitBtn) {
            submitBtn.classList.remove('btn--loading');
            submitBtn.disabled = false;
          }
        }, 600);
      })
      .catch(error => {
        console.error('Error adding to cart:', error);

        // Hide loading state on error too
        if (submitBtn) {
          submitBtn.classList.remove('btn--loading');
          submitBtn.disabled = false;
        }
      });
    });
  }
});
</script>
</script>