<div class="featured-products section">
  <div class="section-header">
    <h2>{{ section.settings.title | escape }}</h2>
  </div>

  <div class="featured-products-container">
    <div class="product-slider">
      <div class="product-slider__wrapper">
        {% assign collection = collections[section.settings.collection] %}
        <div class="product-slider__items" data-products-slider>
          {% for product in collection.products limit: section.settings.products_to_show %}
            <div class="product-slide">
              {% render 'product-card',
                product: product,
                show_rating: section.settings.show_rating,
                show_quick_add: section.settings.enable_quick_add,
                show_secondary_image: true
              %}
            </div>
          {% else %}
            {%- for i in (1..section.settings.products_to_show) -%}
              <div class="product-slide">
                {% render 'product-card-placeholder' %}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>

        <!-- Fixed Navigation arrows with improved mobile visibility -->
        <button type="button" class="slider-button slider-button--prev" aria-label="Previous slide">
          {% render 'icon-arrow-left' %}
        </button>

        <button type="button" class="slider-button slider-button--next" aria-label="Next slide">
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    </div>

    {% if section.settings.view_all_text != blank and section.settings.view_all_url != blank and request.design_mode %}
      <div class="view-all-container desktop-only">
        <a href="{{ section.settings.view_all_url }}" class="view-all-btn">
          {{ section.settings.view_all_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "EXPLORE OUR PRODUCTS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": true,
      "label": "Enable quick add"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Products"
    }
  ]
}
{% endschema %}

<style>
.featured-products {
  padding: 4rem 0 5rem;
  background: white;
  width: 100%;
  max-width: 100%;
  font-family: 'Montserrat', sans-serif;
}

.section-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.section-header h2 {
  font-size: 2.25rem;
  font-weight: 800;
  color: #1a2e37;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-family: 'Montserrat', sans-serif;
}

/* Product slider container */
.product-slider {
  position: relative;
  width: 100%;
  margin: 0 auto;
}

/* Wrapper for slider items and navigation */
.product-slider__wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* Container for product items */
.product-slider__items {
  display: flex;
  overflow-x: auto;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE and Edge */
  padding: 1rem 0;
  width: 100%;
  gap: 1.5rem;
}

.product-slider__items::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}

.product-slide {
  flex: 0 0 auto;
  width: 300px; /* Larger product cards */
  padding: 0.5rem;
}

/* FIXED Slider button styles with improved visibility */
.slider-button {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: white;
  box-shadow: 0 3px 12px rgba(0,0,0,0.15);
  border: none;
  display: flex !important; /* Force display */
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  color: #2A5E41;
  opacity: 1; /* Always visible */
}

.slider-button:hover {
  background: #2A5E41;
  color: white;
  transform: translateY(-50%) scale(1.1);
}

.slider-button--prev {
  left: 10px;
}

.slider-button--next {
  right: 10px;
}

/* Make sure SVG is visible */
.slider-button svg {
  width: 24px;
  height: 24px;
  display: block;
}

.view-all-container {
  text-align: center;
  margin-top: 3rem;
}

.view-all-btn {
  display: inline-flex;
  align-items: center;
  background: #2A5E41;
  color: white;
  font-weight: 600;
  padding: 0.9rem 1.8rem;
  border-radius: 30px;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 0.95rem;
  font-family: 'Montserrat', sans-serif;
  text-decoration: none;
}

.arrow-icon {
  margin-left: 0.5rem;
  transition: transform 0.3s ease;
}

.view-all-btn:hover {
  background: #1e472e;
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
}

.view-all-btn:hover .arrow-icon {
  transform: translateX(5px);
}

/* Hide desktop-only elements on mobile */
.desktop-only {
  display: none;
}

/* Desktop layout (larger grid display) */
@media (min-width: 992px) {
  .product-slider {
    padding: 0 60px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-slider__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    justify-content: space-between;
    padding: 1rem 0;
    overflow-x: visible;
  }

  .product-slide {
    width: 100%;
    padding: 0;
  }

  /* Show desktop elements */
  .desktop-only {
    display: block;
  }

  .slider-button {
    display: none !important;
  }
}

/* Tablet layout */
@media (min-width: 768px) and (max-width: 991px) {
  .product-slider {
    padding: 0 50px;
  }

  .product-slider__items {
    gap: 1.5rem;
  }

  .product-slide {
    width: 260px;
  }

  .section-header h2 {
    font-size: 2rem;
  }
}

/* Mobile layout - one product at a time with visible arrows */
@media (max-width: 767px) {
  .featured-products {
    padding: 2rem 0 3rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
  }

  .product-slider {
    padding: 0 40px;
  }

  .product-slider__items {
    scroll-snap-type: x mandatory;
    padding: 1rem 0;
  }

  .product-slide {
    width: 100%;
    flex: 0 0 100%;
    scroll-snap-align: center;
    padding: 0;
  }

  /* FIXED: Made slider buttons more visible on mobile */
  .slider-button {
    width: 40px;
    height: 40px;
    opacity: 1;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  .slider-button svg {
    width: 20px;
    height: 20px;
  }
}

/* Adjustments for smaller mobile screens */
@media (max-width: 480px) {
  .slider-button {
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    width: auto;
    height: auto;
  }

  .slider-button svg {
    width: 24px;
    height: 24px;
    fill: #2A5E41;
  }

  .slider-button--prev {
    left: 0 !important;
  }

  .slider-button--next {
    right: 0 !important;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const mobileBreakpoint = 768; // Show arrows only on screens less than 768px wide
  const sliders = document.querySelectorAll('[data-products-slider]');

  sliders.forEach((slider) => {
    const wrapper = slider.closest('.product-slider__wrapper');
    if (!wrapper) return;

    const prevBtn = wrapper.querySelector('.slider-button--prev');
    const nextBtn = wrapper.querySelector('.slider-button--next');
    if (!prevBtn || !nextBtn) {
      console.error('Navigation buttons not found for slider');
      return;
    }

    // Function to update arrow visibility based on window width
    const updateArrowVisibility = () => {
      if (window.innerWidth < mobileBreakpoint) {
        prevBtn.style.display = 'flex';
        nextBtn.style.display = 'flex';
      } else {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
      }
    };

    // Get the width of the first slide (fallback to 300 if not found)
    const getSlideWidth = () => {
      const slide = slider.querySelector('.product-slide');
      return slide ? slide.offsetWidth : 300;
    };

    // Bind click events to scroll slider by one slide width
    prevBtn.addEventListener('click', () => {
      slider.scrollBy({ left: -getSlideWidth(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      slider.scrollBy({ left: getSlideWidth(), behavior: 'smooth' });
    });

    // Touch event handling for swipe gestures
    let touchStartX = 0;
    let touchEndX = 0;

    slider.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    });

    slider.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeThreshold = 50; // Minimum swipe distance in pixels
      if (touchEndX < touchStartX - swipeThreshold) {
        nextBtn.click();
      } else if (touchEndX > touchStartX + swipeThreshold) {
        prevBtn.click();
      }
    });

    // Set arrow visibility on load and update on window resize
    updateArrowVisibility();
    window.addEventListener('resize', updateArrowVisibility);
  });
});
</script>
