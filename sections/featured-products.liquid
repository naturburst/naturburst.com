<div class="featured-products section">
  <div class="section-header">
    <h2>{{ section.settings.title | escape }}</h2>
  </div>

  <div class="featured-products-container">
    <div class="product-slider">
      <div class="product-slider__wrapper">
        {% assign collection = collections[section.settings.collection] %}
        <div class="product-slider__items" data-products-slider>
          {% for product in collection.products limit: section.settings.products_to_show %}
            <div class="product-slide">
              {% render 'product-card',
                product: product,
                show_rating: section.settings.show_rating,
                show_quick_add: section.settings.enable_quick_add,
                show_secondary_image: true
              %}
            </div>
          {% else %}
            {%- for i in (1..section.settings.products_to_show) -%}
              <div class="product-slide">
                {% render 'product-card-placeholder' %}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>
      </div>
    </div>

    {% if section.settings.view_all_text != blank and section.settings.view_all_url != blank and request.design_mode %}
      <div class="view-all-container desktop-only">
        <a href="{{ section.settings.view_all_url }}" class="view-all-btn">
          {{ section.settings.view_all_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "EXPLORE OUR PRODUCTS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": true,
      "label": "Enable quick add"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Products"
    }
  ]
}
{% endschema %}

<style>
  .featured-products {
    padding: 4rem 0 5rem;
    background: white;
    width: 100%;
    max-width: 100%;
    font-family: 'Montserrat', sans-serif;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-size: 2.25rem;
    font-weight: 800;
    color: #1a2e37;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-family: 'Montserrat', sans-serif;
  }

  /* Product slider container */
  .product-slider {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  /* Wrapper for slider items and navigation */
  .product-slider__wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* Container for product items */
  .product-slider__items {
    display: flex;
    overflow-x: auto;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
    padding: 1rem 0;
    width: 100%;
    gap: 1.5rem;
    background-color: white; /* Fix blue gap issue */
  }

  .product-slider__items::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }

  .product-slide {
    flex: 0 0 auto;
    width: 300px; /* Larger product cards */
    padding: 0.5rem;
    background-color: white; /* Ensure slide background is white */
  }

  /* Pagination dots */
  .slider-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .slider-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ddd;
    cursor: pointer;
    transition: background 0.3s ease;
    border: none;
    padding: 0;
  }

  .slider-dot.active {
    background: #2A5E41;
  }

  /* View All button styling */
  .view-all-container {
    text-align: center;
    margin-top: 3rem;
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    background: #2A5E41;
    color: white;
    font-weight: 600;
    padding: 0.9rem 1.8rem;
    border-radius: 30px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.95rem;
    font-family: 'Montserrat', sans-serif;
    text-decoration: none;
  }

  .arrow-icon {
    margin-left: 0.5rem;
    transition: transform 0.3s ease;
  }

  .view-all-btn:hover {
    background: #1e472e;
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
  }

  .view-all-btn:hover .arrow-icon {
    transform: translateX(5px);
  }

  /* Hide desktop-only elements on mobile */
  .desktop-only {
    display: none;
  }

  /* Desktop layout (larger grid display) */
  @media (min-width: 992px) {
    .product-slider {
      padding: 0 60px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .product-slider__items {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      justify-content: space-between;
      padding: 1rem 0;
      overflow-x: visible;
    }

    .product-slide {
      width: 100%;
      padding: 0;
    }

    .desktop-only {
      display: block;
    }
  }

  /* Tablet layout */
  @media (min-width: 768px) and (max-width: 991px) {
    .product-slider {
      padding: 0 50px;
    }

    .product-slider__items {
      gap: 1.5rem;
    }

    .product-slide {
      width: 260px;
    }

    .section-header h2 {
      font-size: 2rem;
    }
  }

  /* Mobile layout */
  @media (max-width: 767px) {
    .featured-products {
      padding: 2rem 0 3rem;
    }

    .section-header h2 {
      font-size: 1.5rem;
    }

    .product-slider {
      padding: 0 40px;
    }

    .product-slider__items {
      scroll-snap-type: x mandatory;
      padding: 1rem 0;
    }

    .product-slide {
      width: 100%;
      flex: 0 0 100%;
      scroll-snap-align: center;
      padding: 0;
    }

    .slider-pagination {
      display: flex;
    }
  }

  /* Remove highlight/focus outline on slider buttons */
  .slider-button:focus,
  .slider-button:active,
  .slider-button:focus-visible,
  .slider-dot:focus,
  .slider-dot:active,
  .slider-dot:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  /* For Firefox to remove the dotted line */
  .slider-button::-moz-focus-inner,
  .slider-dot::-moz-focus-inner {
    border: 0 !important;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const sliders = document.querySelectorAll('[data-products-slider]');

  sliders.forEach((slider) => {
    const wrapper = slider.closest('.product-slider__wrapper');
    if (!wrapper) return;

    // Create pagination dots
    const slides = slider.querySelectorAll('.product-slide');
    const paginationContainer = document.createElement('div');
    paginationContainer.className = 'slider-pagination';
    
    // Add pagination dots based on number of slides
    for (let i = 0; i < slides.length; i++) {
      const dot = document.createElement('button');
      dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
      paginationContainer.appendChild(dot);
    }
    
    wrapper.appendChild(paginationContainer);
    
    // Add click events to dots
    const dots = paginationContainer.querySelectorAll('.slider-dot');
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        const slideWidth = getSlideWidth();
        slider.scrollTo({ left: slideWidth * index, behavior: 'smooth' });
        
        // Update active dot
        dots.forEach(d => d.classList.remove('active'));
        dot.classList.add('active');
      });
    });

    // Get the width of the first slide (fallback to 300 if not found)
    const getSlideWidth = () => {
      const slide = slider.querySelector('.product-slide');
      return slide ? slide.offsetWidth : 300;
    };

    // Update active dot based on scroll position
    slider.addEventListener('scroll', () => {
      if (dots.length === 0) return;
      
      const scrollPosition = slider.scrollLeft;
      const slideWidth = getSlideWidth();
      const activeIndex = Math.round(scrollPosition / slideWidth);
      
      dots.forEach((dot, index) => {
        if (index === activeIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    });

    // Touch event handling for swipe gestures
    let touchStartX = 0;
    let touchEndX = 0;

    slider.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].screenX;
    });

    slider.addEventListener('touchend', e => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeThreshold = 50;
      if (touchEndX < touchStartX - swipeThreshold) {
        // Scroll to next slide
        const slideWidth = getSlideWidth();
        const currentIndex = Math.round(slider.scrollLeft / slideWidth);
        let nextIndex = currentIndex + 1;
        
        // If at the last slide, loop back to the first
        if (nextIndex >= slides.length) {
          nextIndex = 0;
        }
        
        slider.scrollTo({ left: slideWidth * nextIndex, behavior: 'smooth' });
        
        // Update active dot
        dots.forEach(d => d.classList.remove('active'));
        if (dots[nextIndex]) dots[nextIndex].classList.add('active');
      } else if (touchEndX > touchStartX + swipeThreshold) {
        // Scroll to previous slide
        const slideWidth = getSlideWidth();
        const currentIndex = Math.round(slider.scrollLeft / slideWidth);
        let prevIndex = currentIndex - 1;
        
        // If at the first slide, loop to the last
        if (prevIndex < 0) {
          prevIndex = slides.length - 1;
        }
        
        slider.scrollTo({ left: slideWidth * prevIndex, behavior: 'smooth' });
        
        // Update active dot
        dots.forEach(d => d.classList.remove('active'));
        if (dots[prevIndex]) dots[prevIndex].classList.add('active');
      }
    });
    
    // Add auto-rotate functionality to cycle through products
    let autoRotateInterval;
    
    const startAutoRotate = () => {
      if (autoRotateInterval) clearInterval(autoRotateInterval);
      
      autoRotateInterval = setInterval(() => {
        const slideWidth = getSlideWidth();
        const currentIndex = Math.round(slider.scrollLeft / slideWidth);
        let nextIndex = currentIndex + 1;
        
        // Loop back to first slide if we're at the end
        if (nextIndex >= slides.length) {
          nextIndex = 0;
        }
        
        slider.scrollTo({ left: slideWidth * nextIndex, behavior: 'smooth' });
        
        // Update active dot
        dots.forEach(d => d.classList.remove('active'));
        if (dots[nextIndex]) dots[nextIndex].classList.add('active');
      }, 5000); // Rotate every 5 seconds
    };
    
    // Start auto-rotation
    startAutoRotate();
    
    // Pause auto-rotation when user interacts with the slider
    slider.addEventListener('mouseenter', () => {
      if (autoRotateInterval) clearInterval(autoRotateInterval);
    });
    
    slider.addEventListener('mouseleave', () => {
      startAutoRotate();
    });
    
    slider.addEventListener('touchstart', () => {
      if (autoRotateInterval) clearInterval(autoRotateInterval);
    });
    
    slider.addEventListener('touchend', () => {
      startAutoRotate();
    });
  });
});
</script>
