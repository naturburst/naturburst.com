<div class="featured-products section">
  <div class="section-header">
    <h2>{{ section.settings.title | escape }}</h2>
  </div>

  <div class="featured-products-container">
    <div class="product-slider">
      <div class="product-slider__wrapper">
        {% assign collection = collections[section.settings.collection] %}
        <div class="product-slider__items" data-products-slider>
          {% for product in collection.products limit: section.settings.products_to_show %}
            <div class="product-slide">
              {% render 'product-card',
                product: product,
                show_rating: section.settings.show_rating,
                show_quick_add: section.settings.enable_quick_add,
                show_secondary_image: true
              %}
            </div>
          {% else %}
            {%- for i in (1..section.settings.products_to_show) -%}
              <div class="product-slide">
                {% render 'product-card-placeholder' %}
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>

        <!-- Fixed Navigation arrows with improved mobile visibility -->
        <button type="button" class="slider-button slider-button--prev" aria-label="Previous slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button type="button" class="slider-button slider-button--next" aria-label="Next slide">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    {% if section.settings.view_all_text != blank and section.settings.view_all_url != blank and request.design_mode %}
      <div class="view-all-container desktop-only">
        <a href="{{ section.settings.view_all_url }}" class="view-all-btn">
          {{ section.settings.view_all_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "EXPLORE OUR PRODUCTS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "Show product rating"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": true,
      "label": "Enable quick add"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all URL"
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Products"
    }
  ]
}
{% endschema %}

<style>
.featured-products {
  padding: 4rem 0 5rem;
  background: white;
  width: 100%;
  max-width: 100%;
  font-family: 'Montserrat', sans-serif;
}

.section-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.section-header h2 {
  font-size: 2.25rem;
  font-weight: 800;
  color: #1a2e37;
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-family: 'Montserrat', sans-serif;
}

/* Product slider container */
.product-slider {
  position: relative;
  width: 100%;
  margin: 0 auto;
}

/* Wrapper for slider items and navigation */
.product-slider__wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
}

/* Container for product items */
.product-slider__items {
  display: flex;
  overflow-x: auto;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE and Edge */
  padding: 1rem 0;
  width: 100%;
  gap: 1.5rem;
}

.product-slider__items::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}

.product-slide {
  flex: 0 0 auto;
  width: 300px; /* Larger product cards */
  padding: 0.5rem;
}

/* FIXED Slider button styles with improved visibility */
.slider-button {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: white;
  box-shadow: 0 3px 12px rgba(0,0,0,0.15);
  border: none;
  display: flex !important; /* Force display */
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  color: #2A5E41;
  opacity: 1; /* Always visible */
}

.slider-button:hover {
  background: #2A5E41;
  color: white;
  transform: translateY(-50%) scale(1.1);
}

.slider-button--prev {
  left: 10px;
}

.slider-button--next {
  right: 10px;
}

/* Make sure SVG is visible */
.slider-button svg {
  width: 24px;
  height: 24px;
  display: block;
}

.view-all-container {
  text-align: center;
  margin-top: 3rem;
}

.view-all-btn {
  display: inline-flex;
  align-items: center;
  background: #2A5E41;
  color: white;
  font-weight: 600;
  padding: 0.9rem 1.8rem;
  border-radius: 30px;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 0.95rem;
  font-family: 'Montserrat', sans-serif;
  text-decoration: none;
}

.arrow-icon {
  margin-left: 0.5rem;
  transition: transform 0.3s ease;
}

.view-all-btn:hover {
  background: #1e472e;
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
}

.view-all-btn:hover .arrow-icon {
  transform: translateX(5px);
}

/* Hide desktop-only elements on mobile */
.desktop-only {
  display: none;
}

/* Desktop layout (larger grid display) */
@media (min-width: 992px) {
  .product-slider {
    padding: 0 60px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-slider__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    justify-content: space-between;
    padding: 1rem 0;
    overflow-x: visible;
  }

  .product-slide {
    width: 100%;
    padding: 0;
  }

  /* Show desktop elements */
  .desktop-only {
    display: block;
  }
}

/* Tablet layout */
@media (min-width: 768px) and (max-width: 991px) {
  .product-slider {
    padding: 0 50px;
  }

  .product-slider__items {
    gap: 1.5rem;
  }

  .product-slide {
    width: 260px;
  }

  .section-header h2 {
    font-size: 2rem;
  }
}

/* Mobile layout - one product at a time with visible arrows */
@media (max-width: 767px) {
  .featured-products {
    padding: 2rem 0 3rem;
  }

  .section-header h2 {
    font-size: 1.5rem;
  }

  .product-slider {
    padding: 0 40px;
  }

  .product-slider__items {
    scroll-snap-type: x mandatory;
    padding: 1rem 0;
  }

  .product-slide {
    width: 100%;
    flex: 0 0 100%;
    scroll-snap-align: center;
    padding: 0;
  }

  /* FIXED: Made slider buttons more visible on mobile */
  .slider-button {
    width: 40px;
    height: 40px;
    opacity: 1;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  .slider-button svg {
    width: 20px;
    height: 20px;
  }
}

/* Adjustments for smaller mobile screens */
@media (max-width: 480px) {
  .slider-button {
    width: 36px;
    height: 36px;
  }

  .slider-button--prev {
    left: 5px;
  }

  .slider-button--next {
    right: 5px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Get all product sliders on the page
  const sliders = document.querySelectorAll('[data-products-slider]');

  sliders.forEach(slider => {
    const prevBtn = slider.parentElement.querySelector('.slider-button--prev');
    const nextBtn = slider.parentElement.querySelector('.slider-button--next');

    if (!prevBtn || !nextBtn) {
      console.error('Navigation buttons not found for slider');
      return;
    }

    console.log('Slider navigation initialized');

    // Calculate slide width for accurate scrolling
    const getSlideWidth = () => {
      const slides = slider.querySelectorAll('.product-slide');
      if (slides.length > 0) {
        // Get actual width including margins and padding
        const slideRect = slides[0].getBoundingClientRect();
        // Full width including margins
        const computedStyle = window.getComputedStyle(slides[0]);
        const marginRight = parseFloat(computedStyle.marginRight || 0);
        const marginLeft = parseFloat(computedStyle.marginLeft || 0);
        return slideRect.width + marginRight + marginLeft;
      }
      return 280; // Fallback dimension
    };

    // Check if we're in mobile view for scroll behavior
    const isMobileView = () => window.innerWidth < 992;

    // Previous button handler with improved navigation
    prevBtn.addEventListener('click', () => {
      console.log('Previous button clicked');

      if (!isMobileView()) {
        // On desktop, do nothing - grid layout
        return;
      }

      const itemWidth = getSlideWidth();
      const currentScroll = slider.scrollLeft;
      const slideCount = slider.querySelectorAll('.product-slide').length;

      // Calculate current slide index more precisely
      const currentIndex = Math.round(currentScroll / itemWidth);

      // Loop to end if at beginning
      if (currentIndex <= 0) {
        slider.scrollTo({
          left: itemWidth * (slideCount - 1),
          behavior: 'smooth'
        });
      } else {
        slider.scrollTo({
          left: itemWidth * (currentIndex - 1),
          behavior: 'smooth'
        });
      }
    });

    // Next button handler with improved navigation
    nextBtn.addEventListener('click', () => {
      console.log('Next button clicked');

      if (!isMobileView()) {
        // On desktop, do nothing - grid layout
        return;
      }

      const itemWidth = getSlideWidth();
      const slideCount = slider.querySelectorAll('.product-slide').length;
      const currentScroll = slider.scrollLeft;

      // Calculate current slide index more precisely
      const currentIndex = Math.round(currentScroll / itemWidth);

      // Loop to beginning if at end
      if (currentIndex >= slideCount - 1) {
        slider.scrollTo({
          left: 0,
          behavior: 'smooth'
        });
      } else {
        slider.scrollTo({
          left: itemWidth * (currentIndex + 1),
          behavior: 'smooth'
        });
      }
    });

    // Make sure navigation is properly set up on mobile
    const updateSliderMode = () => {
      if (isMobileView()) {
        // Enable navigation on mobile
        prevBtn.style.display = 'flex';
        nextBtn.style.display = 'flex';
      } else {
        // Hide navigation on desktop grid view
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
      }
    };

    // Initialize and set up resize listener
    updateSliderMode();
    window.addEventListener('resize', updateSliderMode);

    // Enable swipe navigation for mobile
    let touchStartX = 0;
    let touchEndX = 0;

    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, {passive: true});

    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, {passive: true});

    const handleSwipe = () => {
      if (!isMobileView()) return;

      const swipeThreshold = 50; // Minimum distance for swipe detection
      if (touchEndX < touchStartX - swipeThreshold) {
        // Swipe left - go to next slide
        nextBtn.click();
      } else if (touchEndX > touchStartX + swipeThreshold) {
        // Swipe right - go to previous slide
        prevBtn.click();
      }
    };
  });
});</script>