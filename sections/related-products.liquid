{%- liquid
  # First try to get products from the same collection
  assign related_collection = product.collections.first

  # If no collection found, use all products collection
  if related_collection == blank
    assign related_collection = collections.all
  endif

  # Set the current product id for comparison
  assign current_product_id = product.id

  # Create an array to store related products
  assign related_products = '' | split: ','

  # First pass: gather all potential related products
  for related_product in related_collection.products limit: section.settings.products_to_show
    # Skip the current product
    if related_product.id != current_product_id
      assign related_products = related_products | append: related_product
    endif
  endfor

  # If not enough related products found, try other collections
  if related_products.size < section.settings.products_to_show and product.collections.size > 1
    for collection in product.collections
      if collection.id != related_collection.id
        for related_product in collection.products limit: section.settings.products_to_show
          if related_product.id != current_product_id and related_products.size < section.settings.products_to_show
            # Check if this product is already in our results
            assign is_duplicate = false
            for existing_product in related_products
              if existing_product.id == related_product.id
                assign is_duplicate = true
                break
              endif
            endfor

            # Only add if not a duplicate
            unless is_duplicate
              assign related_products = related_products | append: related_product
            endunless
          endif
        endfor
      endif

      # Break if we have enough products
      if related_products.size >= section.settings.products_to_show
        break
      endif
    endfor
  endif

  # Last resort: If still not enough products, add more from any collection
  if related_products.size < section.settings.products_to_show
    for product_item in collections.all.products limit: 20
      if product_item.id != current_product_id and related_products.size < section.settings.products_to_show
        # Check if this product is already in our results
        assign is_duplicate = false
        for existing_product in related_products
          if existing_product.id == product_item.id
            assign is_duplicate = true
            break
          endif
        endfor

        # Only add if not a duplicate
        unless is_duplicate
          assign related_products = related_products | append: product_item
        endunless
      endif

      # Break if we have enough products
      if related_products.size >= section.settings.products_to_show
        break
      endif
    endfor
  endif
-%}

{%- if related_products.size > 0 -%}
  <div class="related-products__grid">
    {%- for related_product in related_products -%}
      <div class="related-products__item">
        {% render 'product-card',
          product: related_product,
          show_rating: section.settings.show_rating,
          show_quick_add: true,
          show_secondary_image: section.settings.show_secondary_image
        %}
      </div>
    {%- endfor -%}
  </div>
{%- else -%}
  <div class="related-products__empty">
    <p>No related products found.</p>
  </div>
{%- endif -%}