<section class="contact-section">
  <div class="contact-container">
    <h1 class="contact-title">Get In Touch</h1>

    <p class="contact-description">
      We'd love to hear from you! Whether you have questions about our products, want to share your experience, or are interested in wholesale opportunities, our team is here to help.
    </p>

    <div class="contact-details">
      <div class="contact-detail-item">
        <div class="contact-detail-icon">{% render 'icon-map' %}</div>
        <div class="contact-detail-content">
          <h2>Our Location</h2>
          <address>
            Prestige West Woods<br>
            Magadi Road, Gopalpura<br>
            Bengaluru, Karnataka 560023
          </address>
          <a href="https://maps.app.goo.gl/KaVpZLHZUk5bY9H79" class="contact-link">Get Directions</a>
        </div>
      </div>

      <div class="contact-detail-item">
        <div class="contact-detail-icon">{% render 'icon-phone' %}</div>
        <div class="contact-detail-content">
          <h2>Phone</h2>
          <a href="tel:+919098404225" class="contact-text">+91 90984 04225</a>
        </div>
      </div>

      <div class="contact-detail-item">
        <div class="contact-detail-icon">{% render 'icon-email' %}</div>
        <div class="contact-detail-content">
          <h2>Email</h2>
          <a href="mailto:natureburst.shop@gmail.com" class="contact-text">natureburst.shop@gmail.com</a>
        </div>
      </div>

      <div class="contact-detail-item">
        <div class="contact-detail-icon">{% render 'icon-instagram' %}</div>
        <div class="contact-detail-content">
          <h2>Follow Us</h2>
          <a href="https://instagram.com/tropitreats.shop" class="contact-text">@tropitreats.shop</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.contact-section {
  padding: 30px 0;
  background-color: #fff;
  font-family: 'Montserrat', sans-serif;
}

.contact-container {
  width: 100%;
  padding: 0 20px;
}

.contact-title {
  font-size: 2.4rem;
  color: #102F44;
  margin-bottom: 15px;
  font-weight: 700;
  position: relative;
}

.contact-title:after {
  content: '';
  width: 60px;
  height: 4px;
  background-color: #41B3A3;
  position: absolute;
  bottom: -10px;
  left: 0;
  border-radius: 2px;
}

.contact-description {
  font-size: 1rem;
  line-height: 1.6;
  color: #667985;
  margin: 30px 0;
}

.contact-details {
  margin-top: 30px;
}

.contact-detail-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40px;
}

.contact-detail-icon {
  flex-shrink: 0;
  width: 50px;
  margin-right: 15px;
  color: #41B3A3;
}

.contact-detail-content {
  flex-grow: 1;
}

.contact-detail-content h2 {
  font-size: 1.2rem;
  color: #102F44;
  margin: 0 0 8px 0;
  font-weight: 600;
}

.contact-detail-content address {
  font-style: normal;
  font-size: 1rem;
  line-height: 1.5;
  color: #667985;
  margin-bottom: 10px;
}

.contact-text {
  font-size: 1rem;
  color: #667985;
  display: block;
  text-decoration: none;
}

.contact-link {
  display: inline-block;
  padding: 8px 20px;
  background-color: #f0f0f0;
  color: #102F44;
  border-radius: 30px;
  text-decoration: none;
  margin-top: 10px;
  font-size: 0.9rem;
  transition: background-color 0.3s;
}

.contact-link:hover {
  background-color: #e0e0e0;
}

@media (min-width: 768px) {
  .contact-container {
    padding: 0 40px;
    max-width: 90%;
    margin: 0 auto;
  }

  .contact-title {
    font-size: 3rem;
  }

  .contact-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
}

@media (max-width: 480px) {
  .contact-title {
    font-size: 2rem;
  }

  .contact-detail-item {
    margin-bottom: 30px;
  }
}
</style>
