{% if settings.show_announcement %}
<div class="announcement-bar">
  <div class="page-width">
    {% if settings.announcements.size > 0 %}
      <div class="announcement-carousel">
        {% for announcement in settings.announcements %}
          <p class="announcement-bar__message {% unless forloop.first %}hidden{% endunless %}" data-index="{{ forloop.index0 }}">
            {{ announcement.text | replace: '+', '<span class="bullet-point">•</span>' }}
          </p>
        {% endfor %}
      </div>
    {% else %}
      <p class="announcement-bar__message">
        {{ settings.announcement_text | replace: '+', '<span class="bullet-point">•</span>' }}
      </p>
    {% endif %}
  </div>
</div>

{% if settings.announcements.size > 1 %}
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var announcements = document.querySelectorAll('.announcement-bar__message');
      var currentIndex = 0;
      var totalAnnouncements = {{ settings.announcements.size }};
      var rotationSpeed = {{ settings.announcement_rotation_speed | default: 3 }} * 1000;
      
      setInterval(function() {
        announcements[currentIndex].classList.add('hidden');
        currentIndex = (currentIndex + 1) % totalAnnouncements;
        announcements[currentIndex].classList.remove('hidden');
      }, rotationSpeed);
    });
  </script>
{% endif %}
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Buy any 3 or more items at Rs. 149 each + Free shipping"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "category": "Promotional"
    }
  ]
}
{% endschema %}

<style>
.announcement-bar {
  width: 100%;
  background: #1a2e37;
  color: white;
  text-align: center;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 1px;
  padding: 0.25rem 0;
  z-index: 9;
}

.announcement-bar__message {
  display: inline-block;
  margin: 0;
  padding: 0.25rem 0;
  opacity: 1;
  transition: opacity 0.5s ease;
}

.announcement-bar__message.hidden {
  display: none;
}

.announcement-carousel {
  position: relative;
  min-height: 1.5rem;
}

.bullet-point {
  display: inline-block;
  margin: 0 0.5rem;
  color: #FFD166;
  font-size: 1.2rem;
  line-height: 0;
  vertical-align: middle;
}

@media screen and (max-width: 380px) {
  .announcement-bar {
    font-size: 0.7rem;
  }
  
  .bullet-point {
    margin: 0 0.3rem;
    font-size: 1rem;
  }
}
</style>