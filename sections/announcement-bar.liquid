{% if settings.show_announcement %}
<div class="announcement-bar">
  <div class="ticker-wrapper">
    <div class="ticker">
      {% if settings.announcements.size > 0 %}
        <div class="ticker-content">
          {% for announcement in settings.announcements %}
            <span class="ticker-item">{{ announcement.text }}</span>
            <span class="bullet-point">•</span>
          {% endfor %}
          <!-- Repeat for seamless loop -->
          {% for announcement in settings.announcements %}
            <span class="ticker-item">{{ announcement.text }}</span>
            <span class="bullet-point">•</span>
          {% endfor %}
        </div>
      {% else %}
        <div class="ticker-content">
          <span class="ticker-item">{{ settings.announcement_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Buy any 3 or more items at Rs. 149 each"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "category": "Promotional"
    }
  ]
}
{% endschema %}

<style>
.announcement-bar {
  width: 100%;
  background: #1a2e37;
  color: white;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 1px;
  padding: 0.25rem 0;
  z-index: 9;
  overflow: hidden;
}

.ticker-wrapper {
  width: 100%;
  overflow: hidden;
}

.ticker {
  width: 100%;
  padding: 0.25rem 0;
}

.ticker-content {
  display: inline-block;
  white-space: nowrap;
  padding-right: 100%;
  animation: ticker 35s linear infinite;
}

.ticker-item {
  display: inline-block;
  padding: 0 0.3rem;
}

.bullet-point {
  display: inline-block;
  color: #FFD166;
  font-size: 1.5rem;
  line-height: 0;
  vertical-align: middle;
  margin: 0 0.4rem;
}

@keyframes ticker {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media screen and (max-width: 380px) {
  .announcement-bar {
    font-size: 0.7rem;
  }
  
  .bullet-point {
    margin: 0 0.3rem;
    font-size: 1.2rem;
  }
}
</style>