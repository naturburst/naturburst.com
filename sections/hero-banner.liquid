<!-- Updated hero-banner.liquid code -->
<div class="hero-banner">
  <div class="hero-container{% if template.name == 'index' %} hero-container--home{% endif %}">
    <div class="hero-content">
      {% if section.settings.show_buttons %}
        <div class="hero-buttons">
          <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
            {% render 'icon-cart' %}
            {{ section.settings.shop_button_text | escape }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
.hero-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 0;
  margin: 0; /* Remove top margin to eliminate gap */
  margin-bottom: 2rem;
  font-family: 'Montserrat', sans-serif;
}

.hero-container {
  /* Using contain to ensure the whole image is visible */
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  min-height: 600px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  border-bottom: 3px solid #f7f7f7;
}

.hero-content {
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  position: relative;
  z-index: 2;
  padding-bottom: 2rem;
}

.hero-buttons {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  justify-content: center;
}

/* Button styles */
.button {
  display: inline-block;
  padding: 12px 24px;
  background-color: #3f704d; /* Darker green */
  color: white;
  text-transform: uppercase;
  font-weight: bold;
  border-radius: 30px;
  transition: all 0.3s ease;
  border: none;
  text-decoration: none;
  font-family: 'Montserrat', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.button:hover {
  background-color: #2b4f35;
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(0,0,0,0.25);
}

.button--primary {
  background-color: #3f704d;
  display: flex;
  align-items: center;
  gap: 0.7rem;
}

.button .icon {
  font-size: 1.1rem;
}

/* Mobile responsive adjustments */
@media (max-width: 767px) {
  .hero-container {
    min-height: auto; /* Remove fixed height */
    height: 80vh; /* Use viewport percentage */
    padding: 0;
    background-position: center;
    /* Apply mobile image and force contain so the full image shows */
    background-image: url("{{ section.settings.mobile_image | img_url: 'master' }}") !important;
    background-size: contain !important;
  }

  .hero-container--home {
    height: 80vh; /* Use viewport percentage */
  }

  .hero-content {
    padding-bottom: 0;
    display: flex;
    justify-content: center;
    width: 100%;
    position: absolute;
    bottom: 60px;
  }

  .hero-buttons {
    width: 100%;
    max-width: 280px;
    gap: 1rem;
  }

  .button {
    width: 100%;
    justify-content: center;
    padding: 0.9rem 1.5rem;
    font-size: 1rem;
  }
}

/* Small mobile devices */
@media (max-width: 480px) {
  .hero-content {
    bottom: 40px;
  }
  
  .hero-container {
    height: 70vh; /* Slightly smaller for very small screens */
  }
}
</style>

<script>
// Set background image from Shopify settings
document.addEventListener('DOMContentLoaded', function() {
  const heroContainer = document.querySelector('.hero-container');
  if (heroContainer) {
    const desktopImageUrl = '{{ section.settings.image | img_url: "master" }}';
    if (desktopImageUrl && window.innerWidth > 767) {
      heroContainer.style.backgroundImage = `url(${desktopImageUrl})`;
      // Enforce contain to make sure the full image is visible
      heroContainer.style.backgroundSize = 'contain';
    }
  }
});
</script>