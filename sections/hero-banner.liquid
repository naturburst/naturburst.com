<div class="hero-banner">
  {% assign mobile_image = section.settings.mobile_image | default: section.settings.image %}

  <div class="hero-container{% if template.name == 'index' %} hero-container--home{% endif %}">
    <div class="hero-image-container">
      {% if section.settings.image != blank %}
        <img
          srcset="
            {{ section.settings.image | image_url: width: 480 }} 480w,
            {{ section.settings.image | image_url: width: 768 }} 768w,
            {{ section.settings.image | image_url: width: 1100 }} 1100w,
            {{ section.settings.image | image_url: width: 1500 }} 1500w,
            {{ section.settings.image | image_url: width: 2000 }} 2000w
          "
          src="{{ section.settings.image | image_url: width: 1500 }}"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape | default: shop.name }}"
          loading="eager"
          class="hero-image hero-image--desktop"
        >

        {% if section.settings.mobile_image != blank %}
          <img
            srcset="
              {{ section.settings.mobile_image | image_url: width: 480 }} 480w,
              {{ section.settings.mobile_image | image_url: width: 768 }} 768w
            "
            src="{{ section.settings.mobile_image | image_url: width: 768 }}"
            sizes="100vw"
            alt="{{ section.settings.mobile_image.alt | escape | default: shop.name }}"
            loading="eager"
            class="hero-image hero-image--mobile"
          >
        {% endif %}
      {% endif %}
    </div>

    <div class="hero-content">
      {% if section.settings.show_buttons %}
        <div class="hero-buttons">
          <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
            {% render 'icon-cart' %}
            {{ section.settings.shop_button_text | escape }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "checkbox",
      "id": "show_buttons",
      "label": "Show buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "shop_button_text",
      "label": "Shop Button Text",
      "default": "SHOP NOW"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "category": "Image"
    }
  ]
}
{% endschema %}

<style>
.hero-banner {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 0;
  margin: 0;
  font-family: 'Inter', sans-serif;
  line-height: 0; /* Removes unwanted space */
}

.hero-container {
  position: relative;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin: 0;
  padding: 0;
}

.hero-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0) 60%, rgba(0,0,0,0.35) 100%);
  z-index: 1;
}

.hero-image-container {
  position: relative;
  width: 100%;
  line-height: 0; /* Critical: prevents gap after image */
  display: block;
}

.hero-image {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.hero-image--mobile {
  display: none; /* Hide on desktop */
}

.hero-content {
  position: absolute;
  bottom: 30px;
  max-width: 1200px;
  width: 100%;
  padding: 0 20px;
  z-index: 2;
  line-height: normal; /* Reset line height for content */
}

.hero-buttons {
  display: flex;
  justify-content: center;
  gap: 1rem;
  flex-wrap: wrap;
}

/* Button styles */
.button {
  display: inline-block;
  padding: 12px 24px;
  background: var(--gradient-primary);
  color: white;
  text-transform: uppercase;
  font-weight: bold;
  border-radius: 30px;
  transition: all 0.3s ease;
  border: none;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-size: 1rem;
  letter-spacing: 0.5px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
}

.button:hover {
  background: var(--color-primary-darker);
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(0,0,0,0.25);
}

.button--primary {
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  gap: 0.7rem;
}

/* Mobile responsive adjustments */
@media (max-width: 767px) {
  .hero-image--desktop {
    display: none;
  }

  .hero-image--mobile {
    display: block;
  }

  .hero-content {
    bottom: 20px;
  }

  .hero-buttons {
    width: 100%;
    max-width: 280px;
    margin: 0 auto;
  }

  .button {
    width: 100%;
    justify-content: center;
    padding: 0.9rem 1.5rem;
  }
}
</style>