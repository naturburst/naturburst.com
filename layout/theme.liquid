<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | img_url: '32x32' }}">
  {%- endif -%}

  <!-- SEO -->
  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <!-- Improved Font Loading -->
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Stylesheets -->
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'button.css' | asset_url | stylesheet_tag }}

  <!-- Scripts -->
  <script src="{{ 'mobile-nav-controller.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  <!-- Shopify required -->
  {{ content_for_header }}

  <style>
    /* Critical CSS for faster rendering */
    body {
      font-family: 'Montserrat', sans-serif;
      margin: 0;
      padding: 0;
    }

    /* Remove gap after announcement bar */
    .announcement-bar + main {
      margin-top: 0;
    }

    /* Remove any extra spacing between sections */
    .section {
      margin-top: 0;
    }

    /* Fix any unwanted gaps between header and content */
    .site-header + main,
    .header-wrapper + main,
    header + main {
      margin-top: 0;
    }
    
    /* Mobile-specific fixes for header-content gap */
    @media (max-width: 767px) {
      main {
        margin-top: 0 !important;
      }
      
      .content-for-layout {
        margin-top: 0;
      }
      
      .header-wrapper {
        margin-bottom: 0;
      }
      
      .hero-banner {
        margin-top: -1px;
      }
    }
  </style>
</head>

<body class="template-{{ template.name | handle }}">
  {% section 'header' %}

  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% render 'footer-section' %}

  <!-- Modal container for popups -->
  <div id="modal-container"></div>
</body>
</html>